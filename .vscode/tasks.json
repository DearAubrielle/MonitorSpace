{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dir 1 Server",
      "type": "shell",
      "command": "cd space-server-side ; npm start",
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Start Dir 2 Client",
      "type": "shell",
      "command": "cd space-client-side ; npm run dev",
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Auto Start All",
      "dependsOn": ["Start Dir 1 Server", "Start Dir 2 Client"],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
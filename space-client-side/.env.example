# Vite Environment Variables

# Server URL Configuration
# For development
VITE_SERVER_URL=http://localhost:8080

# For production, set this to your actual server URL
# VITE_SERVER_URL=https://monitorspaceflow.onrender.com

# WebSocket URL (optional - if different from server URL)
# VITE_WS_URL=ws://localhost:8080

# For production WebSocket
# VITE_WS_URL=wss://monitorspaceflow.onrender.com